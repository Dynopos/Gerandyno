APP_NAME="DynoPOS Cloud Report"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dynopos_cloud_report
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SalesPlay API
# Left blank by default so the app falls back to the mock client (see
# SalesPlayServiceProvider). Set to enable the real API:
# SALESPLAY_BASE_URL=https://api.salesplaypos.com/v1.0
# Per-account API tokens are NOT set here — they are stored encrypted per
# salesplay_accounts row via the admin panel (generated per-merchant from
# the SalesPlay Backoffice under Integrations > Access token).
SALESPLAY_BASE_URL=
SALESPLAY_TIMEOUT=30

# OpenAI — powers the AI weekly sales review at /reports/ai.
# Left blank by default: with no key the page still shows the week's figures
# and tells the admin the AI review isn't set up yet. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60

# How far back a SalesPlay account's FIRST sync reaches (months). The API
# rejects an open-ended range ("The requested date range is not supported"),
# so a first sync must name a concrete start date. Lower this if a first sync
# is still rejected; raise it to keep more history.
SALESPLAY_INITIAL_SYNC_MONTHS=12
